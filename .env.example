# ── Runtime de la app (Vercel + local) ─────────────────────────────
# Supabase — la URL y la anon/publishable key son públicas por diseño;
# la SECRET key es SOLO server-side, jamás con prefijo NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxx
SUPABASE_SECRET_KEY=sb_secret_xxxx

# Upstash Redis — rate limiting (solo server)
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxx

# Cloudflare Turnstile — la site key es pública, la secret es solo server
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAxxxx
TURNSTILE_SECRET_KEY=0x4AAAxxxx

# Vercel KV — legacy, se elimina al terminar la migración a Supabase
KV_REST_API_URL=https://xxxx.kv.vercel-storage.com
KV_REST_API_TOKEN=tu_token

# ── Tokens de gestión (solo para administrar infra, NO runtime) ────
# SUPABASE_ACCESS_TOKEN=  (Management API — revocar al terminar la migración)
# UPSTASH_API_KEY=
# SENDGRID_API_KEY=       (cargada como SMTP en Supabase Auth, no en Vercel)
# SENDGRID_FROM_EMAIL=
# SENTRY_AUTH_TOKEN=      (fase siguiente)
# POSTHOG_PROJECT_API_KEY= / POSTHOG_PERSONAL_API_KEY= (fase siguiente)
# VERCEL_TOKEN=
# SUPABASE_DB_PASSWORD=   (connection string de backups — vive en GitHub Secrets)
